{
  "schemaVersion": 1,
  "contractVersion": "2.20.0",
  "agentSkillsSpecification": {
    "page": "https://agentskills.io/specification",
    "repository": "https://github.com/agentskills/agentskills",
    "repositorySnapshot": {
      "commit": "69ef37e9424c0a7ea9dd2293b559e43ec8176379",
      "url": "https://github.com/agentskills/agentskills/tree/69ef37e9424c0a7ea9dd2293b559e43ec8176379"
    },
    "authority": "official-page",
    "validatorRole": "cross-check-oracle",
    "officialHardRuleFailure": "block",
    "officialRecommendationFinding": "warning"
  },
  "expertRuntimeProjection": {
    "command": {
      "agentMode": "all",
      "subtask": true
    },
    "agent": {
      "canonicalStepField": "steps",
      "legacyStepInputFields": [
        "max_turns",
        "maxTurns"
      ],
      "deprecatedStepFields": [
        "maxSteps"
      ],
      "forbiddenSamplingFields": [
        "temperature",
        "top_p"
      ]
    }
  },
  "findingCatalogVersion": 2,
  "findingCatalog": {
    "fallbackBySeverity": {
      "warning": {
        "code": "LEGACY_VALIDATION_WARNING",
        "phase": "validation",
        "rootCause": "legacy-unclassified-validation",
        "remediation": "Migrate this validation site to a native finding code."
      },
      "error": {
        "code": "LEGACY_VALIDATION_ERROR",
        "phase": "validation",
        "rootCause": "legacy-unclassified-validation",
        "remediation": "Migrate this validation site to a native finding code."
      }
    },
    "rules": [
      {
        "pattern": "package directory does not exist",
        "code": "PACKAGE_DIRECTORY_MISSING",
        "phase": "package",
        "rootCause": "missing-package",
        "remediation": "Provide an existing expert package directory."
      },
      {
        "pattern": "missing (?:expert\\.json|opencode\\.json)",
        "code": "PACKAGE_REQUIRED_FILE_MISSING",
        "phase": "package",
        "rootCause": "missing-required-file",
        "remediation": "Regenerate the package from expert.json."
      },
      {
        "pattern": "(?:AGENTS\\.md|root AGENTS)",
        "code": "PACKAGE_ROOT_AGENTS_FORBIDDEN",
        "phase": "package",
        "rootCause": "unowned-root-file",
        "remediation": "Move workspace-wide rules into declared instruction files."
      },
      {
        "pattern": "undeclared package file",
        "code": "PACKAGE_UNDECLARED_FILE",
        "phase": "package",
        "rootCause": "undeclared-resource",
        "remediation": "Declare the resource in expert.json or remove it."
      },
      {
        "pattern": "path is outside the package allowlist",
        "code": "PACKAGE_PATH_NOT_OWNED",
        "phase": "package",
        "rootCause": "undeclared-resource",
        "remediation": "Move the file into an owned package path."
      },
      {
        "pattern": "non-distributable (?:directory|file|file suffix)",
        "code": "PACKAGE_NON_DISTRIBUTABLE_CONTENT",
        "phase": "package",
        "rootCause": "non-distributable-content",
        "remediation": "Remove transient or forbidden distribution content."
      },
      {
        "pattern": "package\\.json.*(?:scripts|only dependencies|lifecycle)",
        "code": "PACKAGE_MANAGER_LIFECYCLE_FORBIDDEN",
        "phase": "security",
        "rootCause": "package-lifecycle-script",
        "remediation": "Remove package-manager scripts and lifecycle hooks."
      },
      {
        "pattern": "Python syntax",
        "code": "PYTHON_STATIC_SYNTAX_INVALID",
        "phase": "static-syntax",
        "rootCause": "invalid-python-syntax",
        "remediation": "Fix Python syntax; static diagnosis never imports the module."
      },
      {
        "pattern": "non-portable",
        "code": "PACKAGE_NON_PORTABLE_CONTENT",
        "phase": "portability",
        "rootCause": "non-portable-content",
        "remediation": "Replace machine-specific content with portable values."
      },
      {
        "pattern": "secret-like|secret detected|contains secret",
        "code": "PACKAGE_SECRET_DETECTED",
        "phase": "security",
        "rootCause": "secret-content",
        "remediation": "Remove the secret and reference an environment variable."
      },
      {
        "pattern": "common_skills.*(?:string|purpose)|skills.*legacy",
        "code": "MANIFEST_SKILL_LEGACY_FORMAT",
        "phase": "manifest",
        "rootCause": "legacy-manifest-contract",
        "remediation": "Migrate the package to the unified skills catalog before structural modification."
      },
      {
        "pattern": "maxTurns|max_turns|maxSteps",
        "code": "AGENT_LEGACY_STEP_FIELD",
        "phase": "manifest",
        "rootCause": "legacy-runtime-field",
        "remediation": "Use steps in new manifests and regenerate."
      },
      {
        "pattern": "ROLE_AUTONOMY_REQUIRED|autonomy is required",
        "code": "ROLE_AUTONOMY_REQUIRED",
        "phase": "permission",
        "rootCause": "missing-role-autonomy",
        "remediation": "Choose an explicit autonomy for every role before structural modification."
      },
      {
        "pattern": "ROLE_AUTONOMY_INVALID|autonomy.*must be one of|unsupported role autonomy",
        "code": "ROLE_AUTONOMY_INVALID",
        "phase": "permission",
        "rootCause": "invalid-role-autonomy",
        "remediation": "Use scripted, fixed, bounded, guided, or adaptive."
      },
      {
        "pattern": "cannot raise role autonomy baseline",
        "code": "PERMISSION_AUTONOMY_ESCALATION_FORBIDDEN",
        "phase": "permission",
        "rootCause": "permission-exceeds-role-autonomy",
        "remediation": "Remove the escalation or choose a higher role autonomy explicitly."
      },
      {
        "pattern": "legacy role autonomy|LEGACY_ROLE_AUTONOMY_DEFAULTED",
        "code": "LEGACY_ROLE_AUTONOMY_DEFAULTED",
        "phase": "permission",
        "rootCause": "legacy-role-autonomy-missing",
        "remediation": "Persist an explicit role autonomy before structural modification."
      },
      {
        "pattern": "legacy primary|LEGACY_PRIMARY_AGENT_MODE",
        "code": "LEGACY_PRIMARY_AGENT_MODE",
        "phase": "manifest",
        "rootCause": "legacy-primary-agent-mode",
        "remediation": "Migrate the main Agent mode to all during structural modification."
      },
      {
        "pattern": "permission\\.bash.*(?:unconditional|wildcard)|generated permission\\.bash",
        "code": "PERMISSION_BASH_WILDCARD_ALLOW",
        "phase": "permission",
        "rootCause": "unsafe-bash-permission",
        "remediation": "Use ask or deny for Bash wildcard and exact required patterns."
      },
      {
        "pattern": "permission\\.external_directory.*wildcard",
        "code": "PERMISSION_EXTERNAL_WILDCARD_ALLOW",
        "phase": "permission",
        "rootCause": "unsafe-external-directory",
        "remediation": "Keep wildcard external access at ask or deny."
      },
      {
        "pattern": "permission.*(?:match|mismatch|policy)",
        "code": "PERMISSION_PROJECTION_MISMATCH",
        "phase": "permission",
        "rootCause": "permission-projection-drift",
        "remediation": "Regenerate permissions from autonomy and ownership."
      },
      {
        "pattern": "legacy-permission-baseline",
        "code": "LEGACY_PERMISSION_BASELINE",
        "phase": "permission",
        "rootCause": "legacy-permission-contract",
        "remediation": "Migrate to the unified skill schema during the next structural modification; add Workflow autonomy only when a formal Workflow is declared."
      },
      {
        "pattern": "unused-role-bounded-fallback",
        "code": "UNUSED_ROLE_BOUNDED_FALLBACK",
        "phase": "permission",
        "rootCause": "unassigned-role",
        "remediation": "Assign the role to a workflow or accept bounded fallback."
      },
      {
        "pattern": "workflow|autonomy|execution|executor",
        "code": "WORKFLOW_CONTRACT_INVALID",
        "phase": "workflow",
        "rootCause": "workflow-contract",
        "remediation": "Correct the workflow autonomy or execution contract."
      },
      {
        "pattern": "README\\.md: missing",
        "code": "README_SECTION_MISSING",
        "phase": "documentation",
        "rootCause": "stale-derived-documentation",
        "remediation": "Regenerate README.md from expert.json."
      },
      {
        "pattern": "README\\.md",
        "code": "README_PROJECTION_MISMATCH",
        "phase": "documentation",
        "rootCause": "stale-derived-documentation",
        "remediation": "Regenerate README.md from expert.json."
      },
      {
        "pattern": "frontmatter",
        "code": "MARKDOWN_FRONTMATTER_INVALID",
        "phase": "derived",
        "rootCause": "invalid-frontmatter",
        "remediation": "Regenerate the derived Markdown file."
      },
      {
        "pattern": "\\$schema",
        "code": "RUNTIME_SCHEMA_MISSING",
        "phase": "runtime-config",
        "rootCause": "runtime-config-contract",
        "remediation": "Regenerate root opencode.json."
      },
      {
        "pattern": "opencode\\.json|runtime config",
        "code": "RUNTIME_CONFIG_INVALID",
        "phase": "runtime-config",
        "rootCause": "runtime-config-contract",
        "remediation": "Regenerate root opencode.json from expert.json."
      },
      {
        "pattern": "avatar",
        "code": "AVATAR_CONTRACT_INVALID",
        "phase": "resource",
        "rootCause": "avatar-contract",
        "remediation": "Declare a valid portable avatar and regenerate."
      },
      {
        "pattern": "symlink",
        "code": "PACKAGE_SYMLINK_FORBIDDEN",
        "phase": "security",
        "rootCause": "unsafe-path",
        "remediation": "Replace the symlink with an owned regular file."
      },
      {
        "pattern": "\\.name: is required|description is required",
        "code": "MANIFEST_REQUIRED_FIELD_MISSING",
        "phase": "manifest",
        "rootCause": "missing-manifest-field",
        "remediation": "Add the required manifest field."
      },
      {
        "pattern": "subagents must contain at least one",
        "code": "MANIFEST_TEAM_SUBAGENTS_MISSING",
        "phase": "manifest",
        "rootCause": "missing-team-role",
        "remediation": "Declare at least one subagent."
      },
      {
        "pattern": "missing agent definitions directory",
        "code": "DERIVED_AGENT_DIRECTORY_MISSING",
        "phase": "derived",
        "rootCause": "missing-derived-agent",
        "remediation": "Regenerate Agent Markdown files."
      },
      {
        "pattern": "missing skill directory",
        "code": "DERIVED_SKILL_DIRECTORY_MISSING",
        "phase": "derived",
        "rootCause": "missing-derived-skill",
        "remediation": "Regenerate supplemental Skill files."
      },
      {
        "pattern": "missing (?:primary |sub)?agent file",
        "code": "DERIVED_AGENT_FILE_MISSING",
        "phase": "derived",
        "rootCause": "missing-derived-agent",
        "remediation": "Regenerate Agent Markdown files."
      },
      {
        "pattern": "missing skill file",
        "code": "DERIVED_SKILL_FILE_MISSING",
        "phase": "derived",
        "rootCause": "missing-derived-skill",
        "remediation": "Regenerate supplemental Skill files."
      },
      {
        "pattern": "recommended count is",
        "code": "MANIFEST_RECOMMENDED_COUNT",
        "phase": "manifest",
        "rootCause": "manifest-recommendation",
        "remediation": "Use the recommended number of user-facing examples where practical."
      }
    ]
  },
  "evidenceSchemaVersion": 2,
  "cli": {
    "defaultSchemaVersion": 2,
    "supportedSchemaVersions": [1, 2],
    "formats": ["human", "json"],
    "streamEncoding": "utf-8",
    "v2Fields": [
      "schemaVersion",
      "operation",
      "ok",
      "status",
      "evidenceLevel",
      "gates",
      "runtime",
      "execution",
      "provenance",
      "findings",
      "data"
    ],
    "exitCodes": {
      "success": 0,
      "contractOrSafety": 1,
      "argumentEnvironmentOrVersion": 2,
      "internal": 3,
      "runtimePolicyBlocked": 4
    }
  },
  "gates": {
    "names": ["archive", "contract", "portability", "install", "configLoad"],
    "values": ["passed", "failed", "blocked", "not-run"]
  },
  "evidenceLevels": ["invalid", "valid", "installable", "config-loadable"],
  "runtimeStatuses": ["not-tested", "blocked", "verified"],
  "receiptContract": {
    "writeVersion": 3,
    "readVersions": [1, 2, 3],
    "extendedOwnershipVersions": [2, 3],
    "configLoadableVersions": [3],
    "v3Sha256Fields": [
      "packageTreeSha256",
      "manifestSha256",
      "managerContractSha256",
      "targetCapabilitiesSha256",
      "projectionSha256"
    ],
    "v3StringFields": ["targetOpenCodeVersion"],
    "projectionSchemaVersion": 1,
    "driftPreviewSchemaVersion": 1
  },
  "driftRecovery": {
    "schemaVersion": 1,
    "rootName": ".expert-drift-backups",
    "manifestName": "manifest.json",
    "payloadDirectory": "payload",
    "publishProtocol": "posix-exclusive-directory-v1",
    "backupIdPattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{6}Z(?:-[0-9]{3})?$",
    "dirMode": 448,
    "fileMode": 384
  },
  "workspaceLock": {
    "fileName": ".mobilework-expert-manager.lock",
    "protocolVersion": 2,
    "fields": ["ownerToken", "pid", "createdAt", "heartbeatAt", "protocolVersion"],
    "fileMode": 384,
    "platformBackends": {
      "posix": "implemented",
      "windows": "implemented"
    },
    "windowsProtocol": {
      "directoryAnchor": "reparse-free-held-handle-chain",
      "ownerIdentity": "volume-serial-and-128-bit-file-id",
      "release": "source-handle-no-replace-quarantine-then-delete-on-close",
      "targetTransactionSecurity": "partial"
    },
    "staleReclaim": "not-implemented"
  },
  "reservedCommands": {
    "source": "validated-host-capabilities",
    "fallbackPolicy": "deny-known-server-builtins",
    "names": ["init", "review"]
  },
  "trustedConversionAdapter": {
    "schemaVersion": 1,
    "implementationStatus": "defined",
    "invocationAuthority": "desktop-host-only",
    "managerDirectExecution": "forbidden",
    "forbiddenDirectExecutables": [
      "parse-document",
      "uv",
      "package-script",
      "arbitrary-libreoffice-path"
    ],
    "inputFields": ["sourceSha256", "sourceType"],
    "outputFields": ["artifactSha256", "anchors", "provider"],
    "anchorTypes": ["page", "table", "slide"],
    "providerFields": ["id", "version", "sha256"],
    "unavailableAction": "conversion-required",
    "runtimeEvidenceRequired": true
  },
  "requirementsDiscovery": {
    "schemaVersion": 14,
    "ledgerPersistence": "session-only",
    "ledgerFields": [
      "decision_id",
      "source",
      "status",
      "dependencies",
      "asked_via",
      "blocked_by",
      "resume_status"
    ],
    "sources": ["user", "trusted-material", "candidate", "technical-mapping"],
    "statuses": [
      "open",
      "asked",
      "answered",
      "proposed",
      "confirmed",
      "blocked",
      "superseded"
    ],
    "askedVia": [null, "tool", "body"],
    "questionChannelsMutuallyExclusive": true,
    "questionChannelLimits": {
      "toolAvailable": "up-to-three-independent-question-ready-decisions",
      "toolUnavailable": "one-concise-composite-business-question",
      "bodyQuestionCount": 1,
      "bodyQuestionMustNotUseNumberedSubquestions": true
    },
    "questionChannelEvidence": {
      "askedViaSemantics": "agent-session-bookkeeping",
      "hostAssertionRequires": "complete-host-question-channel-ledger",
      "missingHostEvidenceStatus": "not-verified",
      "skillTextCountsAsHostEvidence": false,
      "assistantSelfReportCountsAsHostEvidence": false
    },
    "creationTargetSelection": {
      "schemaVersion": 1,
      "appliesTo": [
        "create-expert",
        "create-team",
        "convert-material-to-new-expert"
      ],
      "excludedOperations": [
        "modify-existing",
        "install",
        "validate",
        "package"
      ],
      "binding": {
        "scope": "current-whole-card-confirmation-version",
        "invalidatedByDesignChange": true,
        "reselectionRequiredAfterInvalidation": true
      },
      "question": {
        "toolPreference": {
          "recognizedNames": [
            "AskUserQuestion",
            "question"
          ],
          "equivalentCapability": "single-select-with-custom-input",
          "whenAvailable": "must-use"
        },
        "request": {
          "header": "安装位置",
          "question": "确认后，将新专家创建到哪里？",
          "multiple": false,
          "custom": true,
          "options": [
            {
              "label": "我的专家（MobileWork 个人专家目录）",
              "description": "由 MobileWork 宿主解析；独立运行默认使用 ~/.mobilework/experts/personal。"
            },
            {
              "label": "当前工作空间",
              "description": "创建到当前工作空间根目录。"
            }
          ]
        },
        "replyMapping": {
          "event": "question.replied",
          "eventAnswerPath": "properties.answers[0][0]",
          "requiredQuestionAnswerCount": 1,
          "requiredSelectedLabelCount": 1,
          "fixedLabels": [
            {
              "label": "我的专家（MobileWork 个人专家目录）",
              "creationTarget": "my-experts"
            },
            {
              "label": "当前工作空间",
              "creationTarget": "workspace"
            }
          ],
          "unmatchedSingleAnswer": "custom"
        },
        "fallback": {
          "when": "no-equivalent-ask-user-tool-available",
          "channel": "assistant-body",
          "question": "确认后，将新专家创建到哪里？",
          "choices": [
            "我的专家（MobileWork 个人专家目录）",
            "当前工作空间"
          ],
          "customInstruction": "也可以回复其他已存在的绝对父目录。",
          "mustAwaitReply": true
        }
      },
      "budget": {
        "consumesDiscoveryRound": false,
        "consumesDecisionBudget": false,
        "invalidatesConfirmedBusinessCard": false
      },
      "executionGate": {
        "position": "after-current-whole-card-confirmation-before-execution",
        "preAnswerForbidden": [
          "environment-preflight",
          "process",
          "filesystem-write",
          "network",
          "data-egress",
          "plugin",
          "mcp",
          "permission-expansion",
          "generator",
          "validation"
        ],
        "validAnswerCount": 1,
        "toolUnavailableAction": "ask-in-conversation",
        "bodyFallbackAllowed": true
      },
      "errors": {
        "ambiguousAnswer": "CREATION_TARGET_ANSWER_AMBIGUOUS",
        "invalidPath": "CREATION_TARGET_PATH_INVALID",
        "targetOutsideRoot": "TARGET_OUTSIDE_ROOT"
      },
      "customPath": {
        "meaning": "parent-directory",
        "finalPath": "<parent>/<slug>",
        "mustExist": true,
        "mustBeAbsolute": true,
        "forbidden": [
          "filesystem-root",
          "symlink",
          "windows-reparse-point",
          "special-file",
          "path-escape"
        ],
        "overwriteAction": "separate-force-confirmation"
      }
    },
    "roleAutonomySelection": {
      "schemaVersion": 1,
      "appliesTo": [
        "create-expert",
        "create-team",
        "structural-modification"
      ],
      "excludedOperations": [
        "read-only-diagnostics",
        "validate",
        "install",
        "package"
      ],
      "roles": {
        "expert": ["agent"],
        "team": ["primary_agent", "each-subagent"]
      },
      "values": [
        {"value": "scripted", "label": "低", "externalSkill": "deny"},
        {"value": "fixed", "label": "较低", "externalSkill": "deny"},
        {"value": "bounded", "label": "中", "externalSkill": "deny"},
        {"value": "guided", "label": "较高", "externalSkill": "ask"},
        {"value": "adaptive", "label": "高", "externalSkill": "allow"}
      ],
      "selectionRule": "one-explicit-value-per-role",
      "permissionBaseline": "role-autonomy-only",
      "workflowPhaseAffectsPermission": false,
      "legacyReadInstallDefault": "bounded",
      "legacyWarning": "LEGACY_ROLE_AUTONOMY_DEFAULTED",
      "structuralModificationRequiresExplicit": true
    },
    "capabilityImplementationMapping": {
      "defaultMode": "manager-selects-minimal-fit",
      "rolePresenceCreatesResource": false,
      "responsibilityTextDirectProjection": "forbidden",
      "candidateResourceTypes": [
        "none",
        "skill",
        "custom-tool",
        "opencode-plugin"
      ],
      "candidateEvidenceSources": [
        "user-goal",
        "role-responsibility",
        "workflow",
        "quality-requirement",
        "trusted-material",
        "explicit-request",
        "uploaded-resource"
      ],
      "candidateOnlyEvidenceSources": [
        "role-responsibility",
        "workflow",
        "quality-requirement"
      ],
      "resourceSemantics": {
        "none": "no-capability-resource-generated",
        "skill": "reusable-method-checklist-sop-guidance-or-python-shell-script-bundle",
        "custom-tool": "agent-invoked-deterministic-javascript-or-typescript-capability",
        "opencode-plugin": "event-listener-tool-interceptor-or-runtime-behavior-modifier"
      },
      "selectionConstraints": {
        "externalSystemAccessUsesMcpNotPlugin": true,
        "existingPythonOrShellStaysInSkillExecutor": true,
        "preferLeastRuntimePower": true,
        "oneResourcePerRuntimeResponsibility": true,
        "multiResourceCombinationRequiresDistinctConfirmedRuntimeResponsibilities": true,
        "sharedCapabilityUsesOneResourceWithMultipleRoleReferences": true,
        "localPluginOwnership": "package-wide-not-role-owned",
        "generatedExpertRuntimeMutation": "forbidden"
      },
      "businessTruthBoundary": {
        "managerMayInferTechnicalMapping": true,
        "managerMayProposeBusinessCapability": true,
        "managerMayInventBusinessCapabilityOrRule": false,
        "candidateRequires": [
          "stable-business-label",
          "observable-runtime-behavior",
          "trusted-provenance"
        ],
        "missingBusinessRuleAction": "keep-material-decision-open-and-ask-authorized-source"
      },
      "authorization": {
        "requiresCurrentWholeCardConfirmation": true,
        "cardMustConfirm": [
          "business-capability-name",
          "usage-scope",
          "trigger-or-invocation",
          "inputs-and-outputs",
          "visible-side-effects",
          "permissions-cost-and-runtime-prerequisites",
          "quality-gates",
          "implementation-status"
        ],
        "technicalCarrierChoiceDelegatedToManager": true,
        "extraTechnicalConfirmation": "not-required-for-behavior-preserving-mapping-within-confirmed-boundaries",
        "materialMappingImpacts": [
          "automatic-trigger",
          "external-write",
          "network",
          "permission",
          "dependency",
          "cost",
          "runtime-prerequisite"
        ],
        "materialMappingChangeAction": "invalidate-prior-confirmation-and-run-full-card-first",
        "preReconfirmationWriteAction": "forbidden",
        "generationAuthorizationScope": "current-expert-package-resources-only",
        "generationDoesNotAuthorize": [
          "install",
          "enable",
          "network-download",
          "external-connection",
          "permission-expansion",
          "execute-generated-code",
          "release"
        ]
      },
      "naming": {
        "skill": {
          "format": "full-semantic-kebab-case",
          "expertOrRolePrefixRequired": false,
          "userMayModifySuggestedName": true
        },
        "customTool": {
          "namespace": "<slug>-<name>-or-<slug>/<name>",
          "workspaceCollisionNamespaceRequired": true
        },
        "localPlugin": {
          "namespace": "<slug>-<name>-or-<slug>/<name>",
          "workspaceCollisionNamespaceRequired": true
        },
        "legacyPurposePrefix": "preserved",
        "internalReferenceFallback": "<slug>-reference-<alias>"
      },
      "zeroResourceProjection": {
        "condition": "no-fit-confirmed-capability",
        "topLevelSkills": "empty-or-omitted",
        "roleSkills": "empty-or-omitted",
        "skillsDirectory": "present-and-empty",
        "toolsDirectory": "omitted",
        "pluginsDirectory": "omitted",
        "skillMarkdownCount": 0,
        "customToolCount": 0,
        "pluginCount": 0,
        "opencodePluginConfig": "omitted"
      },
      "npmPlugin": {
